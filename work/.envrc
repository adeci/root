# shellcheck shell=bash
# nix-direnv roots every input with `nix flake archive`, which fails where the
# private (ssh) inputs can't be fetched. Root the public ones instead; `root`
# is this repo.
eval "_nix_direnv_call() $(declare -f _nix | tail -n +2)"
_nix() {
  if [[ $1 == flake && $2 == archive ]]; then
    command nix eval --impure --json --expr '
      let lock = builtins.fromJSON (builtins.readFile ./flake.lock); in
      map (node: (builtins.fetchTree (removeAttrs node.locked [ "__final" ])).outPath)
        (builtins.filter (node: node ? locked && node.locked.type != "path"
            && builtins.match "ssh://.*" (node.locked.url or "") == null)
          (builtins.attrValues (removeAttrs lock.nodes [ lock.root ])))'
  else
    _nix_direnv_call "$@"
  fi
}
use flake
