+        root.gpuUsage = Math.max(0, Math.min(100, Number(value)));
+        root.gpuUsageAvailable = true;
+        root.pushGpuUsageHistory();
+      } else {
+        root.gpuUsage = 0;
+        root.gpuUsageAvailable = false;
+      }
+    }
