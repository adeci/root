+        "[ -r \"$path\" ] || continue; read -r value < \"$path\" || continue; " +
+        "case $value in ''|*[!0-9]*) continue;; esac; " +
+        "[ -z \"$max\" ] || [ \"$value\" -le \"$max\" ] || max=$value; " +
+        "[ -n \"$max\" ] || max=$value; done; " +
+        "if command -v nvidia-smi >/dev/null 2>&1; then " +
+        "nvidia=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | " +
+        "awk 'BEGIN { max = -1 } $1 ~ /^[0-9]+$/ && $1 > max { max = $1 } END { if (max >= 0) print max }'); " +
+        "case $nvidia in ''|*[!0-9]*) ;; *) [ -z \"$max\" ] || [ \"$nvidia\" -le \"$max\" ] || max=$nvidia; " +
+        "[ -n \"$max\" ] || max=$nvidia;; esac; fi; " +
+        "if command -v intel_gpu_top >/dev/null 2>&1; then " +
+        "intel=$(intel_gpu_top -J -s 500 -n 2 -o - 2>/dev/null | " +
+        "awk '/\"engines\": \\{/ { in_engines = 1; next } /\"clients\": \\{/ { in_engines = 0 } " +
+        "in_engines && /\"busy\":/ { value = $2; gsub(/,/, \"\", value); " +
+        "if (value ~ /^[0-9]+([.][0-9]+)?$/ && value > max) max = value } " +
+        "END { if (max >= 0) printf \"%.0f\\n\", max }'); " +
+        "case $intel in ''|*[!0-9]*) ;; *) [ -z \"$max\" ] || [ \"$intel\" -le \"$max\" ] || max=$intel; " +
+        "[ -n \"$max\" ] || max=$intel;; esac; fi; " +
+        "printf '%s\\n' \"${max:-unavailable}\""
+    ]
+    stdout: StdioCollector {}
+    stderr: StdioCollector {}
+
+    onExited: function(exitCode) {
