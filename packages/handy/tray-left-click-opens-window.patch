-# TEMPORARY: tao pinned past 0.35.3 for the Wayland client-side-decorations fix
-# (tao #1218, fixes tauri #11856 — dead titlebar buttons after visible(false) →
-# show()). Drop this once a tao release containing it lands in tauri.
-#
-# The rev is a cjpais/tao branch, not upstream: dev past 0.35.3 also carries
-# tao #1231 (removed window subclassing), which left the thread event target's
-# WNDPROC falling through to DefSubclassProc. On a no-longer-subclassed window
-# that returns 0, so WM_QUERYENDSESSION answered FALSE and vetoed Windows
-# shutdown (Handy #1710). `handy` = 07f3742b + a cherry-pick of tao #1274
-# (DefSubclassProc → DefWindowProcW). Repoint at upstream once #1274 merges.
-#
-# tao-macros must be patched to the SAME rev even though nothing here depends on
-# it directly: wry pulls tao-macros 0.1.3 from crates.io, so without this the
-# lockfile carries two tao-macros 0.1.3 entries (registry + git). cargo tolerates
-# that, but Nix's importCargoLock vendors both to the same `tao-macros-0.1.3`
-# dir and fails with a symlink collision. Unifying the source removes the dup.
-[patch.crates-io]
-tao = { git = "https://github.com/cjpais/tao", rev = "c3bee28c1d446d95f08c95c3b6f8d4bde052b876" }
-tao-macros = { git = "https://github.com/cjpais/tao", rev = "c3bee28c1d446d95f08c95c3b6f8d4bde052b876" }
+# tray-icon's StatusNotifierItem backend reports clicks (libappindicator has no
+# Activate method), so a left click on the tray can open the window.
+tray-icon = { version = "0.25", default-features = false, features = ["ksni"] }
 
 [dev-dependencies]
 tempfile = "3"
