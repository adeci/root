+    /// Returns the named cursor enlarged by shake-to-find.
+    ///
+    /// Loads the icon at a larger size so the cursor stays sharp, then scales it around the
+    /// pointer position, which keeps the hotspot in place.
+    fn shaken_pointer_element<R: NiriRenderer>(
+        &self,
+        renderer: &mut R,
+        icon: CursorIcon,
+        scale: i32,
+        cursor: &XCursor,
+        pointer_pos: Point<f64, Logical>,
+        output_scale: Scale<f64>,
+    ) -> Option<RescaleRenderElement<MemoryRenderBufferRenderElement<R>>> {
+        let shake_scale = self.cursor_shake.scale(self.clock.now_unadjusted());
+        let max_scale = self.config.borrow().cursor.shake_to_find_scale;
+        let large_scale = scale * max_scale.ceil() as i32;
+        let large = self
+            .cursor_manager
+            .get_cursor_with_name(icon, large_scale)
+            .unwrap_or_else(|| self.cursor_manager.get_default_cursor(large_scale));
+
+        let millis = self.start_time.elapsed().as_millis() as u32;
+        let (_, frame) = cursor.frame(millis);
+        let (idx, large_frame) = large.frame(millis);
+
+        // At shake scale 1 this matches the normal cursor's logical size, whichever image
+        // sizes the theme provides.
+        let normal_width = f64::from(frame.width) / f64::from(scale);
+        let large_width = f64::from(large_frame.width) / f64::from(large_scale);
+        let rescale = shake_scale * normal_width / large_width;
+
+        let hotspot = XCursor::hotspot(large_frame).to_logical(large_scale);
+        let pos = (pointer_pos - hotspot.to_f64()).to_physical_precise_round(output_scale);
+        let origin = pointer_pos.to_physical_precise_round(output_scale);
+
+        let texture = self
+            .cursor_texture_cache
+            .get(icon, large_scale, &large, idx);
+        match MemoryRenderBufferRenderElement::from_buffer(
+            renderer,
+            pos,
+            &texture,
+            None,
+            None,
+            None,
+            Kind::Cursor,
+        ) {
+            Ok(element) => Some(RescaleRenderElement::from_element(element, origin, rescale)),
+            Err(err) => {
+                warn!("error importing a cursor texture: {err:?}");
+                None
+            }
+        }
+    }
+
+    pub fn update_cursor_shake(&mut self, pos: Point<f64, Logical>) {
+        // Ignore drags and other grabs.
+        if self.seat.get_pointer().unwrap().is_grabbed() {
+            self.cursor_shake.reset_history();
+            return;
+        }
+
+        let max_scale = self.config.borrow().cursor.shake_to_find_scale();
+        let now = self.clock.now_unadjusted();
+        self.cursor_shake.on_motion(pos, now, max_scale);
+    }
