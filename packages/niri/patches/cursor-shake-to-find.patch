@@ -0,0 +1,236 @@
+//! Shake-to-find: temporarily enlarge the cursor when the pointer is shaken.
+//!
+//! Detection follows KWin's shake cursor effect: keep recent pointer positions, merge
+//! consecutive movements in the same direction, and report a shake when the travelled
+//! distance is much longer than the diagonal of the area it covered.
+
+use std::time::Duration;
+
+use smithay::utils::{Logical, Point};
+
+/// How far back pointer positions are considered.
+const HISTORY_WINDOW: Duration = Duration::from_millis(1000);
+/// Travelled distance divided by the bounding box diagonal needed to count as a shake.
+const SHAKE_FACTOR: f64 = 4.;
+/// Minimum bounding box diagonal, in logical pixels, so that jitter does not count.
+const MIN_DIAGONAL: f64 = 100.;
+/// Deltas within this many logical pixels count as either direction.
+const DIRECTION_TOLERANCE: f64 = 1.;
+/// Duration of growing and shrinking.
+const ANIMATION_DURATION: Duration = Duration::from_millis(200);
+/// How long the cursor stays enlarged after the last detected shake.
+const HOLD_DURATION: Duration = Duration::from_millis(1000);
+
+#[derive(Debug, Default)]
+pub struct CursorShake {
+    history: Vec<(Point<f64, Logical>, Duration)>,
+    magnify: Option<Magnify>,
+}
+
+/// An enlargement: grow from `from` to `to` starting at `start`, then shrink back to 1 at
+/// `shrink_at`.
+#[derive(Debug, Clone, Copy)]
+struct Magnify {
+    from: f64,
+    to: f64,
+    start: Duration,
+    shrink_at: Duration,
+}
+
+impl CursorShake {
+    /// Feeds a new pointer position.
+    ///
+    /// `max_scale` is the configured enlargement, or `None` when the feature is disabled.
+    pub fn on_motion(&mut self, pos: Point<f64, Logical>, now: Duration, max_scale: Option<f64>) {
+        let Some(max_scale) = max_scale else {
+            self.reset();
+            return;
+        };
+
+        if self
+            .magnify
+            .is_some_and(|m| m.shrink_at + ANIMATION_DURATION <= now)
+        {
+            self.magnify = None;
+        }
+
+        if !self.detect(pos, now) {
+            return;
+        }
+
+        self.magnify = Some(match self.magnify {
+            // Still growing or holding: keep the current animation, extend the hold.
+            Some(m) if now < m.shrink_at => Magnify {
+                shrink_at: now + HOLD_DURATION,
+                ..m
+            },
+            // Idle or shrinking: grow from the current scale.
+            _ => Magnify {
+                from: self.scale(now),
+                to: max_scale,
+                start: now,
+                shrink_at: now + HOLD_DURATION,
+            },
+        });
+    }
+
+    /// Forgets the movement history, for example while a button is held.
+    pub fn reset_history(&mut self) {
+        self.history.clear();
+    }
+
+    pub fn reset(&mut self) {
+        self.history.clear();
+        self.magnify = None;
+    }
+
+    /// Returns the cursor scale at `now`; 1 when not enlarged.
+    pub fn scale(&self, now: Duration) -> f64 {
+        let Some(m) = self.magnify else {
+            return 1.;
+        };
+
+        let grown = |t: Duration| animate(m.from, m.to, m.start, t);
+        if now < m.shrink_at {
+            grown(now)
+        } else {
+            animate(grown(m.shrink_at), 1., m.shrink_at, now)
+        }
+    }
+
+    /// Whether the scale is not 1 or may still change, so redraws must continue.
+    pub fn is_active(&self, now: Duration) -> bool {
+        self.magnify
+            .is_some_and(|m| now < m.shrink_at + ANIMATION_DURATION)
+    }
+
+    fn detect(&mut self, pos: Point<f64, Logical>, now: Duration) -> bool {
+        self.history
+            .retain(|(_, time)| now.saturating_sub(*time) < HISTORY_WINDOW);
+
+        if let [.., prev, last] = &mut self.history[..] {
+            let same_direction = same_sign(last.0.x - prev.0.x, pos.x - last.0.x)
+                && same_sign(last.0.y - prev.0.y, pos.y - last.0.y);
+            if same_direction {
+                *last = (pos, now);
+                return false;
+            }
+        }
+
+        self.history.push((pos, now));
+
+        let first = self.history[0].0;
+        let (mut min, mut max) = (first, first);
+        let mut distance = 0.;
+        for pair in self.history.windows(2) {
+            let (a, b) = (pair[0].0, pair[1].0);
+            distance += (b.x - a.x).hypot(b.y - a.y);
+            min = Point::from((min.x.min(b.x), min.y.min(b.y)));
+            max = Point::from((max.x.max(b.x), max.y.max(b.y)));
+        }
+
+        let diagonal = (max.x - min.x).hypot(max.y - min.y);
+        if diagonal < MIN_DIAGONAL || distance / diagonal <= SHAKE_FACTOR {
+            return false;
+        }
+
+        self.history.clear();
+        true
+    }
+}
+
+fn same_sign(a: f64, b: f64) -> bool {
+    (a >= -DIRECTION_TOLERANCE && b >= -DIRECTION_TOLERANCE)
+        || (a <= DIRECTION_TOLERANCE && b <= DIRECTION_TOLERANCE)
+}
+
+/// Ease from `from` to `to` over [`ANIMATION_DURATION`] starting at `start`.
+fn animate(from: f64, to: f64, start: Duration, now: Duration) -> f64 {
+    let t = now.saturating_sub(start).as_secs_f64() / ANIMATION_DURATION.as_secs_f64();
+    let t = t.min(1.);
+    // Cubic ease-in-out.
+    let eased = if t < 0.5 {
+        4. * t * t * t
+    } else {
+        1. - (-2. * t + 2.).powi(3) / 2.
+    };
+    from + (to - from) * eased
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ms(ms: u64) -> Duration {
+        Duration::from_millis(ms)
+    }
+
+    /// Moves back and forth horizontally by `amplitude`, one reversal every 20 ms.
+    fn shake(shake: &mut CursorShake, start: u64, reversals: u64, amplitude: f64) -> u64 {
+        let mut t = start;
+        for i in 0..reversals {
+            let x = if i % 2 == 0 { amplitude } else { 0. };
+            // Two samples per stroke, so strokes have intermediate motion.
+            shake.on_motion(Point::from((x / 2., 0.)), ms(t), Some(3.));
+            shake.on_motion(Point::from((x, 0.)), ms(t + 10), Some(3.));
+            t += 20;
+        }
+        t
+    }
+
+    #[test]
+    fn straight_motion_does_not_trigger() {
+        let mut s = CursorShake::default();
+        for i in 0..100 {
+            s.on_motion(Point::from((i as f64 * 10., 0.)), ms(i * 5), Some(3.));
+        }
+        assert!(!s.is_active(ms(500)));
+        assert_eq!(s.scale(ms(500)), 1.);
+    }
+
+    #[test]
+    fn small_jitter_does_not_trigger() {
+        let mut s = CursorShake::default();
+        shake(&mut s, 0, 30, 20.);
+        assert!(!s.is_active(ms(600)));
+    }
+
+    #[test]
+    fn shake_grows_holds_and_shrinks() {
+        let mut s = CursorShake::default();
+        let t = shake(&mut s, 0, 12, 150.);
+        assert!(s.is_active(ms(t)));
+
+        // Fully grown after the animation and during the hold.
+        assert_eq!(s.scale(ms(t + 250)), 3.);
+        // Back to normal after hold and shrink.
+        assert_eq!(s.scale(ms(t + 1300)), 1.);
+        assert!(!s.is_active(ms(t + 1300)));
+    }
+
+    #[test]
+    fn disabled_resets() {
+        let mut s = CursorShake::default();
+        let t = shake(&mut s, 0, 12, 150.);
+        assert!(s.is_active(ms(t)));
+        s.on_motion(Point::from((0., 0.)), ms(t), None);
+        assert!(!s.is_active(ms(t)));
+        assert_eq!(s.scale(ms(t)), 1.);
+    }
+
+    #[test]
+    fn scale_is_continuous_when_regrowing_while_shrinking() {
+        let mut s = CursorShake::default();
+        shake(&mut s, 0, 12, 150.);
+        let shrink_at = s.magnify.unwrap().shrink_at;
+
+        // Shake again shortly after shrinking started.
+        shake(&mut s, (shrink_at + ms(50)).as_millis() as u64, 12, 150.);
+        let m = s.magnify.unwrap();
+
+        // Regrowth starts from the partly shrunk scale, not from 1 or the maximum.
+        assert!(m.start > shrink_at);
+        assert!(m.from > 1. && m.from < 3., "{}", m.from);
+        assert_eq!(s.scale(m.start), m.from);
+    }
+}
