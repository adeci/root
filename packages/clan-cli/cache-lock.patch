--- a/clan_lib/flake/flake_concurrency_test.py
+++ b/clan_lib/flake/flake_concurrency_test.py
@@ -0,0 +1,76 @@
+"""Exercise selector reads against a concurrent disk-cache replacement."""
+
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from threading import Event, RLock
+from types import TracebackType
+from unittest.mock import patch
+
+from clan_lib.flake.flake import Flake, FlakeCache
+
+
+class _ObservedLock:
+    """Expose a competing acquisition so the test needs no scheduling sleeps."""
+
+    def __init__(self, attempted: Event) -> None:
+        self.lock = RLock()
+        self.attempted = attempted
+
+    def __enter__(self) -> None:
+        if self.lock.acquire(blocking=False):
+            return
+        self.attempted.set()
+        self.lock.acquire()
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: TracebackType | None,
+    ) -> None:
+        self.lock.release()
+
+
+def test_select_survives_concurrent_cache_reload(tmp_path: Path) -> None:
+    selector = "clanInternals.vars.settings.publicModule"
+    value = "clan_lib.vars.public_modules.in_repo"
+    cache = FlakeCache()
+    cache.insert("sops", "clanInternals.vars.settings.secretModule")
+    cache_path = tmp_path / "cache.json"
+    cache.save_to_file(cache_path)
+    # Another evaluation has produced a value not yet present in the disk snapshot.
+    cache.insert(value, selector)
+    flake = Flake("unused")
+    flake._cache = cache
+    flake.flake_cache_path = cache_path
+
+    reading = Event()
+    reload_attempted = Event()
+    select = cache.select
+
+    def paused_select(request: str) -> object:
+        reading.set()
+        if not reload_attempted.wait(5):
+            raise TimeoutError("Cache reload thread never reached the read")
+        return select(request)
+
+    def reload_cache() -> None:
+        if not reading.wait(5):
+            raise TimeoutError("Selector thread never reached the cache read")
+        try:
+            flake.load_cache()
+        finally:
+            # Without synchronization, release the reader only after replacement.
+            # With synchronization, _ObservedLock releases it before blocking.
+            reload_attempted.set()
+
+    with (
+        patch.dict("os.environ", {"CLAN_NO_SELECT_DISK_CACHE": "0"}),
+        patch.object(flake, "_cache_lock", _ObservedLock(reload_attempted), create=True),
+        patch.object(cache, "select", paused_select),
+        ThreadPoolExecutor(max_workers=2) as pool,
+    ):
+        reader = pool.submit(flake.select, selector)
+        reloader = pool.submit(reload_cache)
+        assert reader.result(timeout=10) == value
+        reloader.result(timeout=10)
