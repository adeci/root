let
  shared =
    {
      config,
      lib,
      pkgs,
      self,
      ...
    }:
    let
      package = self.packages.${pkgs.stdenv.hostPlatform.system}.kagi-search;
      kagi-search =
        pkgs.runCommand "kagi-search"
          {
            nativeBuildInputs = [ pkgs.makeBinaryWrapper ];
            meta.mainProgram = "kagi-search";
          }
          ''
            mkdir -p $out
            cp -r ${package}/share $out/share
            makeWrapper ${lib.getExe package} $out/bin/kagi-search \
              --set-default KAGI_SESSION_FILE ${config.clan.core.vars.generators.kagi-search.files.session-link.path}
          '';

      # Generated by the installed herdr so the integration version matches it.
      herdrIntegrations = pkgs.runCommand "herdr-integrations" { } ''
        export HOME=$out
        mkdir -p $HOME/.omp/agent/extensions $HOME/.pi/agent/extensions
        ${config.wrappers.herdr.wrapper}/bin/herdr integration install omp
        ${config.wrappers.herdr.wrapper}/bin/herdr integration install pi
      '';
    in
    {
      clan.core.vars.generators.kagi-search = {
        share = true;
        files.session-link = {
          secret = true;
          owner = self.users.alex.username;
          mode = "0400";
        };
        prompts.session-link = {
          description = "Kagi session link or token for kagi-search on AI-tools machines";
          type = "hidden";
          persist = true;
        };
      };

      environment.systemPackages = [ kagi-search ];

      home.links = {
        ".agents/skills/kagi-search" = "${kagi-search}/share/skills/kagi-search";
        ".omp/agent/extensions/herdr-omp-agent-state.ts" =
          "${herdrIntegrations}/.omp/agent/extensions/herdr-omp-agent-state.ts";
        ".pi/agent/extensions/herdr-agent-state.ts" =
          "${herdrIntegrations}/.pi/agent/extensions/herdr-agent-state.ts";
      };
    };
in
{
  nixos =
    { config, self, ... }:
    {
      imports = [
        self.modules.nixos.wrappers
        shared
      ];

      clan.core.vars.generators.kagi-search.files.session-link.group =
        config.users.users.${self.users.alex.username}.group;
    };

  darwin =
    { self, ... }:
    {
      imports = [
        self.modules.darwin.wrappers
        shared
      ];

      clan.core.vars.generators.kagi-search.files.session-link.group = "staff";
    };
}
