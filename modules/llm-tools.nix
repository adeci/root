let
  module =
    class:
    {
      config,
      inputs,
      pkgs,
      self,
      ...
    }:
    let
      llm-agents = inputs.llm-agents.packages.${pkgs.stdenv.hostPlatform.system};

      # Generated by the installed herdr so the integration version matches it.
      herdrIntegrations = pkgs.runCommand "herdr-integrations" { } ''
        export HOME=$out
        mkdir -p $HOME/.omp/agent/extensions $HOME/.pi/agent/extensions
        ${config.wrappers.herdr.wrapper}/bin/herdr integration install omp
        ${config.wrappers.herdr.wrapper}/bin/herdr integration install pi
      '';
    in
    {
      imports = [
        self.modules.${class}.wrappers
        self.modules.${class}.home-links
        self.modules.${class}.kagi-search
      ];

      wrappers.herdr.enable = true;

      environment.systemPackages = [
        llm-agents.pi
        llm-agents.omp
        llm-agents.codex
        llm-agents.claude-code
        llm-agents.grok
        llm-agents.grok-bot
        llm-agents.openspec
        llm-agents.workmux
      ];

      home.links = {
        ".omp/agent/extensions/herdr-omp-agent-state.ts" =
          "${herdrIntegrations}/.omp/agent/extensions/herdr-omp-agent-state.ts";
        ".pi/agent/extensions/herdr-agent-state.ts" =
          "${herdrIntegrations}/.pi/agent/extensions/herdr-agent-state.ts";
      };
    };
in
{
  nixos = module "nixos";
  darwin = module "darwin";
}
