+    #[test]
+    fn test_replace_changed_crtc_lifecycle() {
+        let crtc = crtc();
+        let a = output_name(Some("Visitech AS"), Some("VITURE Beast"), Some("A"));
+        let b = output_name(Some("Microstep"), Some("MSI MAG321CQR"), Some("B"));
+        let configs = Outputs(vec![Output {
+            name: b.format_make_model_serial(),
+            ..Default::default()
+        }]);
+        let a_id = OutputId::next();
+        let mut known_crtcs = HashMap::from([(
+            crtc,
+            CrtcInfo {
+                id: a_id,
+                name: a.clone(),
+            },
+        )]);
+
+        // A complete A -> B Changed event retires A before reconnect/config matching sees B.
+        assert!(configs.find(&a).is_none());
+        let retired = replace_changed_crtc(&mut known_crtcs, crtc, b.clone()).unwrap();
+        let b_info = known_crtcs.get(&crtc).unwrap();
+        assert_eq!(retired.id, a_id);
+        assert_ne!(b_info.id, retired.id);
+        assert_eq!(
+            b_info.name.format_make_model_serial(),
+            b.format_make_model_serial()
+        );
+        assert_eq!(
+            configs.find(&b_info.name).unwrap().name,
+            b.format_make_model_serial()
+        );
+        assert_eq!(known_crtcs.len(), 1);
+        assert!(!known_crtcs.values().any(|info| info.id == retired.id));
+
+        // A Changed event caused only by a mode-list update keeps B's identity and OutputId.
+        let b_id = b_info.id;
+        assert!(replace_changed_crtc(
+            &mut known_crtcs,
+            crtc,
+            output_name(Some("microstep"), Some("msi mag321cqr"), Some("b")),
+        )
+        .is_none());
+        assert_eq!(known_crtcs.get(&crtc).unwrap().id, b_id);
+        assert_eq!(known_crtcs.len(), 1);
+
+        // Incomplete EDID is mode-only. An initially incomplete output becomes B exactly once
+        // when its complete EDID arrives, without leaving a second CRTC/output identity.
+        let incomplete = output_name(Some("Microstep"), Some("MSI MAG321CQR"), None);
+        assert!(replace_changed_crtc(&mut known_crtcs, crtc, incomplete.clone()).is_none());
+        let incomplete_id = OutputId::next();
+        let mut incomplete_known = HashMap::from([(
+            crtc,
+            CrtcInfo {
+                id: incomplete_id,
+                name: incomplete,
+            },
+        )]);
+        let retired = replace_changed_crtc(&mut incomplete_known, crtc, b).unwrap();
+        assert_eq!(retired.id, incomplete_id);
+        assert_ne!(incomplete_known.get(&crtc).unwrap().id, retired.id);
+        assert_eq!(incomplete_known.len(), 1);
+    }
