@@ -3387,0 +3431,37 @@ fn make_output_name(
+fn output_identity_changed(old: &OutputName, new: &OutputName) -> bool {
+    // Changed events may carry a transient empty EDID while a dock initializes. Only a complete
+    // fresh identity replaces an output; once complete, it is compared with OutputName::matches(),
+    // the same case-insensitive make/model/serial semantics used for config matching.
+    let complete =
+        |name: &OutputName| name.make.is_some() && name.model.is_some() && name.serial.is_some();
+
+    complete(new) && (!complete(old) || !old.matches(&new.format_make_model_serial()))
+}
+
+/// Replaces a complete, changed output identity for one CRTC with a fresh output ID.
+///
+/// The caller owns external effects: it disconnects the old logical output first, then the normal
+/// output-config pass reconnects this identity and matches its configuration.
+fn replace_changed_crtc(
+    known_crtcs: &mut HashMap<crtc::Handle, CrtcInfo>,
+    crtc: crtc::Handle,
+    name: OutputName,
+) -> Option<CrtcInfo> {
+    let old = known_crtcs.get(&crtc)?;
+    if !output_identity_changed(&old.name, &name) {
+        return None;
+    }
+
+    Some(
+        known_crtcs
+            .insert(
+                crtc,
+                CrtcInfo {
+                    id: OutputId::next(),
+                    name,
+                },
+            )
+            .expect("known CRTC disappeared during replacement"),
+    )
+}
